classDiagram
    class Owner {
        +str name
        +list~Pet~ pets
        +list~Commitment~ commitments
        +add_pet(pet)
        +add_commitment(commitment)
        +get_all_tasks() list~Task~
        +pet_for(task) Pet
    }

    class Commitment {
        +str label
        +str start
        +str end
        +overlaps(time) bool
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task)
    }

    class Task {
        +str description
        +str type
        +str time
        +str priority
        +str frequency
        +date due_date
        +bool completed
        +mark_complete() Task
    }

    class Scheduler {
        +Owner owner
        +get_tasks_for(day) list~Task~
        +sort_by_time(tasks) list~Task~
        +filter_tasks(pet_name, completed) list~Task~
        +mark_task_complete(task) Task
        +detect_conflicts(day) list~str~
        +build_daily_plan(day) list~Task~
        +busy_commitment(task) Commitment
        +get_reminders(now) list~Task~
    }

    Owner "1" --> "*" Pet : has
    Owner "1" --> "*" Commitment : has
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : plans for
